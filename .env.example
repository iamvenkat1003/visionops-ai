# Copy to backend/.env. Relative paths resolve from backend/.
DATABASE_URL=sqlite:///./data/visionops.db
DATA_DIR=./data
# Leave blank for an automatically generated, persisted local secret.
JWT_SECRET=
JWT_EXPIRY_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEMO_MODE=false
SEED_DEMO_USERS=true
# Local-only documented demonstration credentials; override before any deployment.
DEMO_EMPLOYEE_PASSWORD=EmployeeDemo!2026
DEMO_ADMIN_PASSWORD=AdminDemo!2026
MODEL_PATH=./data/models/yolo11n.pt
MODEL_DEVICE=cpu
CONFIDENCE_THRESHOLD=0.25
MAX_UPLOAD_MB=10
# Optional bearer token for a future Prometheus scraper; admin JWTs also work.
METRICS_TOKEN=
